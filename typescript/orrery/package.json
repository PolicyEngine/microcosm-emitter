{
  "name": "@policyengine/microcosm-provider-orrery",
  "version": "0.1.0",
  "description": "Validated immutable publication reads for Orrery applications",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PolicyEngine/microcosm-local-provider.git",
    "directory": "typescript/orrery"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format:check": "prettier --check src tests *.json README.md"
  },
  "peerDependencies": {
    "@axiom-foundation/orrery": "0.6.1"
  },
  "devDependencies": {
    "@axiom-foundation/orrery": "0.6.1",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
